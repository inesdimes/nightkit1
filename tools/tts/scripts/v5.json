[["L1", 0.3, "This is me.", 0.99], ["L2", 2.3, "And that... is also me.", 1.49], ["L3", 5.9, "Nine HP. No potions. No way back.", 3.1], ["L4", 9.9, "Then I saw the red light. A save point.", 2.54], ["L5", 14.3, "I made it. I was safe.", 1.39], ["L6", 20.7, "Game saved. I could finally rest.", 2.48], ["L7", 23.45, "Then I heard footsteps.", 1.39], ["L8", 25.4, "But I was the only player here.", 1.8], ["L9", 31.1, "Same crack.", 0.91], ["L10", 32.3, "Same cloth.", 0.96], ["L11", 33.7, "Whatever I did... it did.", 1.77], ["L12", 36.0, "So I stopped.", 1.04], ["L13", 37.25, "It didn't.", 0.8], ["L14", 38.3, "And my body followed it.", 1.35], ["L15", 40.7, "It walked to my save point.", 1.57], ["L16", 43.7, "It didn't press save.", 1.26], ["L17", 49.1, "When you load a save... the old you has to go somewhere.", 3.37], ["L18", 52.75, "Now it plays as me.", 1.28], ["L19", 54.2, "And I'm not the first.", 1.39]]